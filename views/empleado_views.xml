
<odoo>

    <!-- Vista LIST -->
    <record id="view_empleado_list" model="ir.ui.view">
        <field name="name">streetzone.empleado.list</field>
        <field name="model">streetzone.empleado</field>
        <field name="arch" type="xml">
            <list string="Lista de empleados">
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="telefono"/>
                <field name="correo"/>
                <field name="puesto"/>
                <field name="fecha_contratacion"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM -->
    <record id="view_empleado_form" model="ir.ui.view">
        <field name="name">streetzone.empleado.form</field>
        <field name="model">streetzone.empleado</field>
        <field name="arch" type="xml">
            <form string="Ficha del empleado">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="apellidos"/>
                        <field name="dni"/>
                        <field name="telefono"/>
                        <field name="correo"/>
                        <field name="puesto"/>
                        <field name="fecha_contratacion"/>
                        <field name="activo"/>
                        <field name="descripcion"/>
                        <field name="ventas_realizadas"/>
                        <field name="productos_asignados"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista SEARCH -->
    <record id="view_empleado_search" model="ir.ui.view">
        <field name="name">streetzone.empleado.search</field>
        <field name="model">streetzone.empleado</field>
        <field name="arch" type="xml">
            <search string="Buscar empleados">
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="puesto"/>
            </search>
        </field>
    </record>

    <!-- Acción que enlaza las vistas -->
    <record id="action_empleado" model="ir.actions.act_window">
        <field name="name">Empleados</field>
        <field name="res_model">streetzone.empleado</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_empleado_list"/>
        <field name="search_view_id" ref="view_empleado_search"/>
    </record>

    <!-- Menú de empleados -->
    <menuitem id="menu_empleado"
              name="Empleados"
              parent="menu_streetzone_root"
              action="action_empleado"/>

</odoo>

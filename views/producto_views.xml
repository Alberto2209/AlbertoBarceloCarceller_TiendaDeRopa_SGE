<odoo>

    <!-- Vista LIST -->
    <record id="view_producto_list" model="ir.ui.view">
        <!-- Nombre de la vista -->
        <field name="name">streetzone.producto.list</field>
        <field name="model">streetzone.producto</field>
        <field name="arch" type="xml">
            <list string="Lista de productos">
                <!-- Cada field es un apartado de la tabla -->
                <field name="nombre"/>
                <field name="categoria"/>
                <field name="talla"/>
                <field name="color"/>
                <field name="precio"/>
                <field name="stock"/>
                <field name="valor_stock"/>
                <field name="disponibilidad"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM: -->
    <record id="view_producto_form" model="ir.ui.view">
        <field name="name">streetzone.producto.form</field>
        <field name="model">streetzone.producto</field>
        <field name="arch" type="xml">
            <form string="Ficha del producto">
                <!-- sheet es la zona donde va todo -->
                <sheet>
                    <!-- group ordena los campos  -->
                    <group>
                        <field name="nombre"/>
                        <field name="categoria"/>
                        <field name="talla"/>
                        <field name="color"/>
                        <field name="precio"/>
                        <field name="stock"/>
                        <field name="valor_stock"/>
                        <field name="disponibilidad"/>
                        <field name="fecha_anadido"/>
                        <field name="ultima_actualizacion"/>
                        <field name="descripcion"/>
                        <!-- widget="image" hace que se vea la foto en vez de un archivo -->
                        <field name="imagen" widget="image"/>
                        <field name="empleados_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista SEARCH -->
    <record id="view_producto_search" model="ir.ui.view">
        <field name="name">streetzone.producto.search</field>
        <field name="model">streetzone.producto</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="nombre"/>
                <field name="categoria"/>
                <field name="color"/>
            </search>
        </field>
    </record>

    <!-- Acción: junta las vistas  -->
    <record id="action_producto" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">streetzone.producto</field>
        <!-- Primero sale la lista y luego puedes abrir el formulario -->
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_producto_list"/>
        <field name="search_view_id" ref="view_producto_search"/>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_streetzone_root"
            name="StreetZone"
            sequence="10"/>

    <!-- Submenú de Productos -->
    <menuitem id="menu_producto"
              name="Productos"
              parent="menu_streetzone_root"
              action="action_producto"/>

</odoo>